-- Clear existing map objects
local function ClearMap()
	for _, v in ipairs(W:GetChildren()) do
		if not v:IsA("Terrain") and not v:IsA("Camera") and not Players:GetPlayerFromCharacter(v) then
			pcall(function() v:Destroy() end)
		end
	end
	if CLEAR_LIGHTING then
		for _, v in ipairs(L:GetChildren()) do
			if LIGHT_CLASSES[v.ClassName] then pcall(function() v:Destroy() end) end
		end
	end
end

-- Build copied instances (Part, Mesh, Decal, Texture, Fire, Particle, Spawn, etc.)
local function Make(class, props, parent, meshId)
	local inst
	if class == "MeshPart" then
		if meshId and meshId ~= "" then
			local cached = meshCache[meshId]
			if cached then
				inst = cached:Clone()
			else
				local ok, mp = pcall(function() return AssetService:CreateMeshPartAsync(meshId) end)
				if not ok and Content and Content.fromUri then
					ok, mp = pcall(function() return AssetService:CreateMeshPartAsync(Content.fromUri(meshId)) end)
				end
				if ok and mp then
					meshCache[meshId] = mp
					inst = mp:Clone()
				end
			end
		end
		if not inst then inst = Instance.new("Part") end
	else
		inst = Instance.new(class)
	end
	for k, v in pairs(props) do
		pcall(function() inst[k] = v end)
	end
	inst.Parent = parent
	return inst
end

-- Link object references (Weld / PrimaryPart)
local function Ref(a, prop, b)
	pcall(function() n[a][prop] = n[b] end)
end

-- Teleport player character to spawn location
local function WarpToSpawn(char)
	if #SPAWNS == 0 then return end
	local hrp = char:WaitForChild("HumanoidRootPart", 5)
	if hrp then
		char:PivotTo(SPAWNS[math.random(#SPAWNS)] * CFrame.new(0, 4, 0))
	end
end

